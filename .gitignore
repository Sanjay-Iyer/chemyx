# --- Per-machine local config (NEVER commit your real port) ------------------
config_local.py
.env
# Matches valve/chemyx/nmr .local.json but not the committed *.local.example.json
configs/*.local.json
configs/machines/*.local.yaml
configs/machines/*.local.yml
# Per-machine NMR input/output paths; keep the *.local.example.yaml template.
configs/nmr/*.local.yaml
# Commissioning and short attended-run copies of experiment configs.
configs/experiments/*.local.yaml
arduino/configs/*.local.yaml
arduino/configs/*.local.yml

# --- Offline-laptop bundle payload (offline/build_offline_bundle.ps1) --------
offline/wheelhouse/
offline/installers/
offline/drivers/
offline/BUNDLE_MANIFEST.txt
# Portable arduino-cli plus UNO R4 core (offline/arduino_toolchain.ps1).
offline/arduino/

# --- Local archive / ignored project metadata --------------------------------
archive/
_archive/
# Ignore archive holding directories at every repository depth.
**/archive/
**/_archive/
# The root firmware archive is intentional, small, and required for provenance.
!archive/
!archive/legacy_arduino_firmware/
!archive/legacy_arduino_firmware/**
# Local holding areas for raw/processed runs that should never be committed.
results/archive/
results/processed/archive/
.gitignore

# --- Generated run outputs ---------------------------------------------------
runs/nmr_plots/
results/runs/
runs/arduino/
# Experimental inputs are machine-local. Keep only the documented folder
# skeleton so results/raw/nmr exists after clone/pull.
results/raw/**
!results/raw/README.md
!results/raw/nmr/
!results/raw/nmr/.gitkeep
# Analysis products are also machine-local.
results/analysis/
results/processed/

# --- Python bytecode / caches ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Disposable pytest --basetemp folders from earlier sessions.
test_tmp_*/
arduino/.test-tmp*/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
.venv*/

# --- Packaging / build artifacts ---------------------------------------------
*.egg-info/
build/
dist/

# --- OS junk -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor/IDE --------------------------------------------------------------
.vscode/
.idea/
*.swp
.codex_tmp_deps/
