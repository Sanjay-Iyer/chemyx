# --- Per-machine local config (NEVER commit your real port) ------------------
config_local.py
.env
# Matches valve/chemyx/nmr .local.json but not the committed *.local.example.json
configs/*.local.json
configs/machines/*.local.yaml
configs/machines/*.local.yml
# Per-machine NMR input/output paths; keep the *.local.example.yaml template.
configs/nmr/*.local.yaml
arduino/configs/*.local.yaml
arduino/configs/*.local.yml

# --- Local archive / ignored project metadata --------------------------------
archive/
_archive/
# Ignore archive holding directories at every repository depth.
**/archive/
**/_archive/
# Local holding areas for raw/processed runs that should never be committed.
results/archive/
results/processed/archive/
.gitignore

# --- Generated run outputs ---------------------------------------------------
runs/nmr_plots/
results/runs/
runs/arduino/
# Experimental inputs are machine-local. Keep only the documented folder
# skeleton so results/raw/nmr exists after clone/pull.
results/raw/**
!results/raw/README.md
!results/raw/nmr/
!results/raw/nmr/.gitkeep
# Analysis products are also machine-local.
results/analysis/
results/processed/

# --- Python bytecode / caches ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
.venv*/

# --- Packaging / build artifacts ---------------------------------------------
*.egg-info/
build/
dist/

# --- OS junk -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor/IDE --------------------------------------------------------------
.vscode/
.idea/
*.swp
.codex_tmp_deps/
